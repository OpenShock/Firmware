# ESP-IDF build output
/build
*.bin

.vscode/

# staticfs/www is autogenerated by the frontend build (scripts/build_frontend.py)
# and packed into the static0 partition image at build time.
/staticfs/www

# local config files
*.local

# generated files
.vs
/packages
*.sln
compile_commands.json
managed_components
dependencies.lock

# ESP-IDF: sdkconfig and sdkconfig.old are generated ("DO NOT EDIT") from
# sdkconfig.defaults[.<target>]. Track only the editable defaults.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
!/sdkconfig.defaults.*

# Python bytecode, from the build/CI scripts under scripts/ and .github/scripts/
__pycache__/
*.py[cod]

# Claude Code
.claude/settings.local.json