# ESP-IDF build
/build/
/managed_components/
*.bin

# sdkconfig and sdkconfig.old are generated ("DO NOT EDIT") from
# sdkconfig.defaults[.<target>]. Track only the editable defaults.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
!/sdkconfig.defaults.*

# staticfs/www is autogenerated by the frontend build (scripts/build_frontend.py)
# and packed into the static0 partition image at build time.
/staticfs/www/

# PlatformIO build
/.pio/

# Python
__pycache__/
*.py[cod]

# Editors & IDEs
.vscode/
.vs/
*.sln
/packages/
compile_commands.json
.claude/settings.local.json

# Local overrides
*.local
