# ESP-IDF build
/build/
/managed_components/
*.bin

# sdkconfig and sdkconfig.old are generated ("DO NOT EDIT") from
# sdkconfig.defaults[.<target>]. Track only the editable defaults.
/sdkconfig
/sdkconfig.*
!/sdkconfig.defaults
!/sdkconfig.defaults.*

# Staging directory of scripts/gen_staticfs.py when run from the repository root (the CI
# build-staticfs action); CMake builds stage under build/<board>/staticfs instead.
/staticfs/

# PlatformIO build
/.pio/

# Python
__pycache__/
*.py[cod]

# Editors & IDEs
.vscode/
.vs/
*.sln
/packages/
compile_commands.json
.claude/settings.local.json

# Local overrides
*.local
