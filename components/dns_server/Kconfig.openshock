# Sourced into the OpenShock menu by main/Kconfig.projbuild

menu "Captive portal DNS server"

    config OPENSHOCK_DNS_TASK_STACK_SIZE
        int "DNS server task stack (bytes)"
        range 2048 8192
        default 3072

    config OPENSHOCK_DNS_TASK_PRIORITY
        int "DNS server task priority"
        range 1 24
        default 4
        help
            Above the other application tasks (1): a phone joining the AP sends a burst of
            DNS queries, and the small UDP receive mailbox drops them if this task is starved,
            which delays captive-portal detection by seconds. Keep it below httpd (5) and the
            E-Stop task.

endmenu
