# OpenShock settings that more than one component reads. common sits below every OpenShock
# component, so each of them may use these (scripts/check_kconfig_ownership.py).
#
# The board's GPIO assignments deliberately do NOT live in Kconfig. A Kconfig symbol ends up
# in sdkconfig.h, which most of ESP-IDF includes, so two boards that differed only by an LED
# pin would share no compiled framework objects at all. The pins are stamped into the image
# per board instead (BoardDescriptor.h): bare `OPENSHOCK_*=` lines in boards/<board>.defaults,
# stripped from the sdkconfig fragment by scripts/build.py. Keep every OpenShock option the
# same across boards and build channels (see OPENSHOCK_LOG_LEVEL_CHOICE).
#
# Fixed in code on purpose: the RF protocol timings, the E-Stop debounce, hold and rearm
# times (safety behaviour), task core affinity, and on-flash formats.

menu "OpenShock defaults"

    config OPENSHOCK_API_DOMAIN
        string "OpenShock API domain"
        default "api.openshock.app"
        help
            Default backend API domain the hub connects to. Overridable at runtime.

    config OPENSHOCK_FW_CDN_DOMAIN
        string "Firmware CDN domain"
        default "firmware.openshock.org"
        help
            Default CDN domain used for OTA firmware/version lookups. Overridable at runtime.

    config OPENSHOCK_FW_HOSTNAME
        string "Default hostname"
        default "OpenShock"
        help
            Default network hostname; also the base of the default user agent.

    config OPENSHOCK_FW_AP_PREFIX
        string "SoftAP SSID prefix"
        default "OpenShock-"
        help
            Prefix for the captive-portal SoftAP SSID (the device MAC is appended).

endmenu

# Every OpenShock task's stack and priority, in one place so the priority order between them
# can be read and checked together (the static_asserts in src/TaskUtils.cpp). ESP-IDF's own
# network tasks and the portal's HTTP server run at priority 5.
menu "OpenShock tasks"

    menu "E-Stop"

        config OPENSHOCK_ESTOP_TASK_PRIORITY
            int "Priority"
            range 3 24
            default 10
            help
                Above the network tasks (5) and the RF task: it is blocked almost all the time,
                and a sample that waits behind TLS work delays the E-Stop by that long. Must stay
                above the RF transmitter and DNS server tasks' priorities (checked at compile time).

        config OPENSHOCK_ESTOP_TASK_STACK_SIZE
            int "Stack (bytes)"
            range 2048 16384
            default 4096

    endmenu

    menu "RF transmitter"

        config OPENSHOCK_RF_TASK_PRIORITY
            int "Priority"
            range 2 24
            default 9
            help
                Above the network tasks (5): it blocks on its queue or on RMT almost all the time,
                and frames (and the terminators after an E-Stop) shouldn't wait behind TLS work.
                Must stay above the WiFi manager and DNS server tasks, and below the E-Stop task's
                priority so a press preempts a transmission (checked at compile time).

        config OPENSHOCK_RF_TASK_STACK_SIZE
            int "Stack (bytes)"
            range 2048 16384
            default 4096
            help
                Profiled at about 1.4 KB.

    endmenu

    menu "Keep-alive"

        config OPENSHOCK_KEEPALIVE_TASK_PRIORITY
            int "Priority"
            range 1 24
            default 1

        config OPENSHOCK_KEEPALIVE_TASK_STACK_SIZE
            int "Stack (bytes)"
            range 2048 16384
            default 4096
            help
                Profiled at about 1.5 KB.

    endmenu

    menu "WiFi manager"

        config OPENSHOCK_WIFI_TASK_PRIORITY
            int "Priority"
            range 1 24
            default 5

        config OPENSHOCK_WIFI_TASK_STACK_SIZE
            int "Stack (bytes)"
            range 2048 16384
            default 4096

    endmenu

    menu "Captive portal DNS server"

        config OPENSHOCK_DNS_TASK_PRIORITY
            int "Priority"
            range 1 24
            default 4
            help
                Above the other application tasks (1): a phone joining the AP sends a burst of
                DNS queries, and the small UDP receive mailbox drops them if this task is starved,
                which delays captive-portal detection by seconds. Keep it below httpd (5) and the
                E-Stop task (checked at compile time).

        config OPENSHOCK_DNS_TASK_STACK_SIZE
            int "Stack (bytes)"
            range 2048 8192
            default 3072

    endmenu

    config OPENSHOCK_GATEWAY_TASK_STACK_SIZE
        int "Gateway websocket client stack (bytes)"
        range 4096 16384
        default 6144

    config OPENSHOCK_PORTAL_HTTPD_STACK_SIZE
        int "Captive portal HTTP server stack (bytes)"
        range 4096 32768
        default 8192

    config OPENSHOCK_PORTAL_MANAGER_TASK_STACK_SIZE
        int "Captive portal manager stack (bytes)"
        range 4096 16384
        default 6144

    config OPENSHOCK_PORTAL_ACCOUNT_LINK_TASK_STACK_SIZE
        int "Account link stack (bytes)"
        range 4096 16384
        default 8192
        help
            Runs the HTTPS request that exchanges a link code for a token.

    config OPENSHOCK_OTA_TASK_STACK_SIZE
        int "OTA update stack (bytes)"
        range 8192 32768
        default 16384
        help
            Profiled at about 6.2 KB.

    config OPENSHOCK_SERIAL_RX_TASK_STACK_SIZE
        int "Serial input stack (bytes)"
        range 4096 32768
        default 10000

endmenu
