menu "OpenShock WiFi"

    config OPENSHOCK_WIFI_SCAN_MIN_MS_PER_CHANNEL
        int "Scan time per channel, minimum (ms)"
        range 10 1000
        default 60

    config OPENSHOCK_WIFI_SCAN_MAX_MS_PER_CHANNEL
        int "Scan time per channel, maximum (ms)"
        range OPENSHOCK_WIFI_SCAN_MIN_MS_PER_CHANNEL 1500
        default 120
        help
            At least the minimum. esp_wifi walks every channel itself, so this is the main
            knob for scan duration. Every scan takes the radio off the captive portal AP's
            channel for this long per channel, and portal clients lose frames meanwhile:
            keep it near the ESP-IDF default (120 ms).

    config OPENSHOCK_WIFI_AUTOSCAN_INTERVAL_MS
        int "Auto-scan interval when nothing to connect to (ms)"
        range 10000 3600000
        default 120000

    config OPENSHOCK_WIFI_CONNECT_BACKOFF_MAX_MS
        int "Connect retry backoff cap (ms)"
        range 2000 600000
        default 60000
        help
            A network that failed to connect is retried after 2 s, 4 s, 8 s, ... up to this.

    config OPENSHOCK_WIFI_POWERSAVE_IDLE_MS
        int "Radio stays awake after the last command (ms)"
        range 300000 86400000
        default 3600000
        help
            Modem sleep has the AP hold frames until the next DTIM beacon, delaying each one
            by up to a beacon interval (typically 100-300 ms). Power save is switched off on
            the first shocker command and back on after this long without one. The command
            handler reports activity at most once a minute; that minute is added on top, so the
            radio stays awake at least this long after the last command.

endmenu

menu "OpenShock gateway"

    config OPENSHOCK_GATEWAY_MAX_MESSAGE_SIZE
        int "Largest gateway message (bytes)"
        range 1024 32768
        default 4096

    config OPENSHOCK_GATEWAY_WS_BUFFER_SIZE
        int "Websocket buffer (bytes)"
        range 1024 OPENSHOCK_GATEWAY_MAX_MESSAGE_SIZE
        default 2048
        help
            esp_websocket_client allocates a receive and a send buffer of this size. A message
            larger than it arrives in pieces that are reassembled into a copy; one that fits is
            handled in place.

    config OPENSHOCK_GATEWAY_PING_TIMEOUT_MS
        int "Ping timeout (ms)"
        range 10000 600000
        default 90000
        help
            Reconnect when the gateway sent no ping for this long.

    config OPENSHOCK_GATEWAY_SEND_TIMEOUT_MS
        int "Send timeout (ms)"
        range 1000 60000
        default 10000

    config OPENSHOCK_GATEWAY_AUTH_RETRY_MS
        int "Retry after the backend rejected the token (ms)"
        range 10000 3600000
        default 300000

    config OPENSHOCK_GATEWAY_CONNECT_RETRY_MS
        int "Retry between gateway connection attempts, cap (ms)"
        range 1000 600000
        default 20000

    config OPENSHOCK_GATEWAY_CONNECT_RETRY_MIN_MS
        int "Retry between gateway connection attempts, first (ms)"
        range 1000 OPENSHOCK_GATEWAY_CONNECT_RETRY_MS
        default 2000
        help
            The delay before each connection attempt doubles from this up to the cap. It
            starts over once a connection has stayed up for the cap.

    config OPENSHOCK_GATEWAY_HUB_INFO_RETRY_MIN_MS
        int "Hub info fetch retry, first (ms)"
        range 1000 600000
        default 5000

    config OPENSHOCK_GATEWAY_HUB_INFO_RETRY_MAX_MS
        int "Hub info fetch retry, cap (ms)"
        range OPENSHOCK_GATEWAY_HUB_INFO_RETRY_MIN_MS 3600000
        default 300000
        help
            The retry after a failed hub info fetch doubles from the first value up to this.

endmenu

menu "OpenShock local messages"

    config OPENSHOCK_LOCAL_MAX_MESSAGE_SIZE
        int "Largest local message (bytes)"
        range 1024 32768
        default 4096
        help
            The largest message the local (captive portal websocket) message handler accepts.
            The portal drops a websocket message past this before buffering it.

endmenu
