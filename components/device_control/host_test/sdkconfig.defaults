CONFIG_IDF_TARGET="linux"
CONFIG_IDF_TARGET_LINUX=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_UNITY_ENABLE_IDF_TEST_RUNNER=y

# Same tick rate as the firmware (sdkconfig.defaults at the repo root), so
# pdMS_TO_TICKS in the code under test means the same thing it does on the device.
CONFIG_FREERTOS_HZ=1000
