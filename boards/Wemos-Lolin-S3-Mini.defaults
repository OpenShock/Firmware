# Wemos-Lolin-S3-Mini: auto-ported from platformio.ini. Board-specific deltas only;
# shared config lives in sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OpenShock uses a single 4 MB OTA partition layout (fits every board's flash).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/ota_4mb.csv"

# Native USB only (no USB-UART bridge): console on the built-in USB-Serial-JTAG, so the
# serial console reads commands from the port the host actually sees.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Hardware pins. Not Kconfig: bare OPENSHOCK_* lines, stripped from the sdkconfig fragment by
# scripts/build.py and stamped into the app image after linking by scripts/stamp_board.py,
# so every board on a chip compiles identical objects and one image can serve them all.
OPENSHOCK_LED_WS2812B=47
OPENSHOCK_LED_SWAP_RG_CHANNELS=y
