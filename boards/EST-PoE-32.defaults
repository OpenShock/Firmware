# EST-PoE-32: ESP32-WROOM-32E + LAN8720 + PoE 802.3at, same pin layout as the Olimex ESP32-PoE.
# https://shop.everythingsmart.io/products/est-poe-32-esp32-poe-development-board
# Board-specific deltas only; shared config lives in sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# 8 MB flash on the module, but OpenShock uses the 4 MB OTA layout for now.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/ota_4mb.csv"

# Internal EMAC over RMII; the PHY clock is generated by the ESP32 on GPIO17
# (set in components/core/src/ethernet/EthernetManager.cpp).
CONFIG_ETH_USE_ESP32_EMAC=y

# Hardware pins. Not Kconfig: bare OPENSHOCK_* lines, read by scripts/gen_env_header.py
# into openshock_board.h and stripped from the sdkconfig fragment by scripts/build.py,
# so boards sharing a chip and flash size compile identical ESP-IDF objects.
OPENSHOCK_LED_GPIO=2
OPENSHOCK_RF_TX_GPIO=32
OPENSHOCK_ESTOP_PIN=33
OPENSHOCK_ETHERNET_LAN8720=y
OPENSHOCK_ETH_PHY_ADDR=0
OPENSHOCK_ETH_PHY_POWER_GPIO=12
OPENSHOCK_ETH_MDC_GPIO=23
OPENSHOCK_ETH_MDIO_GPIO=18
