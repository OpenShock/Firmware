# Seeed-Xiao-ESP32S3 — auto-ported from platformio.ini. Board-specific deltas only;
# shared config lives in sdkconfig.defaults.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# OpenShock uses a single 4 MB OTA partition layout (fits every board's flash).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/ota_4mb.csv"

# Hardware pins (see src/Kconfig.projbuild)
CONFIG_OPENSHOCK_LED_GPIO=21
