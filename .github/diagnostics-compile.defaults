# SD card storage for the diagnostics compile check (.github/workflows/diagnostics-compile.yml), with placeholder pins:
# the images are never published or flashed.
CONFIG_OPENSHOCK_DIAG_SDCARD=y
CONFIG_OPENSHOCK_DIAG_SDCARD_CLK_GPIO=12
CONFIG_OPENSHOCK_DIAG_SDCARD_CMD_GPIO=11
CONFIG_OPENSHOCK_DIAG_SDCARD_D0_GPIO=13
CONFIG_OPENSHOCK_DIAG_SDCARD_D1_GPIO=14
CONFIG_OPENSHOCK_DIAG_SDCARD_D2_GPIO=9
CONFIG_OPENSHOCK_DIAG_SDCARD_D3_GPIO=10
CONFIG_OPENSHOCK_DIAG_SDCARD_SCK_GPIO=4
CONFIG_OPENSHOCK_DIAG_SDCARD_MOSI_GPIO=6
CONFIG_OPENSHOCK_DIAG_SDCARD_MISO_GPIO=5
CONFIG_OPENSHOCK_DIAG_SDCARD_CS_GPIO=7
CONFIG_OPENSHOCK_DIAG_SDCARD_CD_GPIO=8
